UPDATE books
SET available = available - 1
WHERE id = 1 AND available > 0;

UPDATE issues
SET returned = CURRENT_DATE
WHERE id = 1 AND returned IS NULL;

UPDATE books
SET available = available + 1
WHERE id = 1;

SELECT * FROM books;

SELECT *
FROM books
WHERE title LIKE '%Code%'
   OR author LIKE '%Code%';

SELECT b.title, i.member, i.issued
FROM issues AS i
JOIN books AS b
ON b.id = i.book_id
WHERE i.returned IS NULL;