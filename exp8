mysql> CREATE DATABASE exp8;

mysql> USE exp8;
Database changed
mysql> CREATE TABLE Employee (
    ->     emp_id INT PRIMARY KEY,
    ->     emp_name VARCHAR(50),
    ->     salary DECIMAL(10,2),
    ->     department VARCHAR(50)
    -> );

mysql> CREATE TABLE Employee_Audit (
    ->     audit_id INT AUTO_INCREMENT PRIMARY KEY,
    ->     emp_id INT,
    ->     action_type VARCHAR(20),
    ->     old_salary DECIMAL(10,2),
    ->     new_salary DECIMAL(10,2)
    -> );

mysql> DELIMITER //
mysql> CREATE TRIGGER after_employee_insert
    -> AFTER INSERT ON Employee
    -> FOR EACH ROW
    -> BEGIN
    -> INSERT INTO Employee_Audit
    -> (emp_id, action_type, new_salary)
    -> VALUES
    -> (NEW.emp_id, 'INSERT', NEW.salary);
    -> END //
mysql> DELIMITER ;

mysql> INSERT INTO Employee
    -> VALUES(101,'Manikant',5000 ,'CSE');

mysql> SELECT * FROM Employee_Audit;
