SELECT
    p.property_name,
    t.tenant_name,
    r.rent,
    r.start_date
FROM Rental AS r
JOIN Property AS p
    ON r.property_id = p.property_id
JOIN Tenant AS t
    ON r.tenant_id = t.tenant_id;

SELECT
    p.property_name,
    p.location,
    p.price,
    o.owner_name
FROM Property AS p
JOIN Owner AS o
    ON p.owner_id = o.owner_id;

SELECT property_name, price
FROM Property
WHERE price > 4000000;

SELECT SUM(rent) AS total_monthly_rent
FROM Rental;