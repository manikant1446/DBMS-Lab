CREATE DATABASE EmployeeDB;

mysql> USE EmployeeDB;

mysql> CREATE TABLE Employee (
    ->     EmpID INT PRIMARY KEY,
    ->     EmpName VARCHAR(50),
    ->     Department VARCHAR(50),
    ->     Salary DECIMAL(10,2),
    ->     City VARCHAR(50)
    -> );

