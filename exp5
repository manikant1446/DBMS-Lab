mysql> SELECT Student.Stud_ID,
    -> Student.Stud_Name,
    -> Department.Dept_Name
    -> FROM Student
    -> INNER JOIN Department
    -> ON Student.Dept_ID = Department.Dept_ID;
+---------+-----------+-----------+
| Stud_ID | Stud_Name | Dept_Name |
+---------+-----------+-----------+
|       1 | Manikant  | CSE       |
|       2 | Khushal   | IT        |
