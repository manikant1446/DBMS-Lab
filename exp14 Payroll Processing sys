CREATE DATABASE IF NOT EXISTS student_payroll;
USE student_payroll;

-- Create students table
CREATE TABLE students (
    student_id INT PRIMARY KEY,
    student_name VARCHAR(50),
    department VARCHAR(30),
    basic_stipend DECIMAL(10,2)
);

