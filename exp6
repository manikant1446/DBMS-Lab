mysql> CREATE DATABASE BankDB;

mysql> USE BankDB;
Database changed

mysql> CREATE TABLE Account(
    -> AccNo INT PRIMARY KEY,
    -> AccName VARCHAR(50),
    -> Balance DECIMAL(10,2));

mysql> INSERT INTO Account VALUES
    -> (101,'Manikant',50000),
    -> (102,'Khushal',30000);

mysql> SELECT * FROM Account;
+-------+----------+----------+
| AccNo | AccName  | Balance  |
+-------+----------+----------+
|   101 | Manikant | 50000.00 |
|   102 | Khushal  | 30000.00 |
+-------+----------+----------+


mysql> CREATE USER 'manikant'@'localhost' IDENTIFIED BY '12345678';

mysql> GRANT SELECT, UPDATE ON BankDB.Account TO 'manikant'@'localhost';

mysql> SHOW GRANTS FOR 'manikant'@'localhost';

+----------------------------------------------------------------------+
| Grants for manikant@localhost                                        |
+----------------------------------------------------------------------+
| GRANT USAGE ON *.* TO `manikant`@`localhost`                         |
| GRANT SELECT, UPDATE ON `bankdb`.`account` TO `manikant`@`localhost` |
+----------------------------------------------------------------------+

mysql> START TRANSACTION;

mysql> UPDATE Account SET Balance = Balance - 5000 WHERE AccNo = 101;

mysql> SAVEPOINT sp1;

mysql> UPDATE Account SET Balance = Balance + 5000 WHERE AccNo = 102;

mysql> SELECT * FROM Account;
+-------+----------+----------+
| AccNo | AccName  | Balance  |
+-------+----------+----------+
|   101 | Manikant | 45000.00 |
|   102 | Khushal  | 35000.00 |
+-------+----------+----------+

mysql> ROLLBACK TO sp1;

mysql> SELECT * FROM Account;
+-------+----------+----------+
| AccNo | AccName  | Balance  |
+-------+----------+----------+
|   101 | Manikant | 45000.00 |
|   102 | Khushal  | 30000.00 |
+-------+----------+----------+

mysql> ROLLBACK;

mysql> SELECT * FROM Account;
+-------+----------+----------+
| AccNo | AccName  | Balance  |
+-------+----------+----------+
|   101 | Manikant | 50000.00 |
|   102 | Khushal  | 30000.00 |
+-------+----------+----------+

mysql> UPDATE Account SET Balance = Balance + 1234 WHERE AccNo = 102;

mysql> COMMIT;

mysql> SELECT * FROM Account;
+-------+----------+----------+
| AccNo | AccName  | Balance  |
+-------+----------+----------+
|   101 | Manikant | 50000.00 |
|   102 | Khushal  | 31234.00 |
+-------+----------+----------+

mysql> REVOKE UPDATE ON BankDB.Account FROM 'manikant'@'localhost';

mysql> SHOW GRANTS FOR 'manikant'@'localhost';

+--------------------------------------------------------------+
| Grants for manikant@localhost                                |
+--------------------------------------------------------------+
| GRANT USAGE ON *.* TO `manikant`@`localhost`                 |
| GRANT SELECT ON `bankdb`.`account` TO `manikant`@`localhost` |
+--------------------------------------------------------------+
