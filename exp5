    ->     (2, 'Khushal', 20, 102),
    ->     (3, 'Manan', 19, 103),
    ->     (4, 'Keshav', 20, 104),
    ->     (5, 'Nikhil', 16, 104),
    ->     (6, 'Nihal', 17, 105),
