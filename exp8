|        1 |    101 | INSERT      |       NULL |    5000.00 |
+----------+--------+-------------+------------+------------+

mysql> DELIMITER //
mysql> CREATE TRIGGER after_employee_update
    -> AFTER UPDATE ON Employee
    -> FOR EACH ROW
    -> BEGIN
    -> INSERT INTO Employee_Audit
    -> (emp_id, action_type, old_salary, new_salary)
    -> VALUES
    -> (NEW.emp_id, 'UPDATE', OLD.salary, NEW.salary);
    -> END //
mysql> DELIMITER ;

mysql> UPDATE Employee
    -> SET salary = 60000
    -> WHERE emp_id = 101;

mysql> SELECT * FROM Employee_Audit;
+----------+--------+-------------+------------+------------+
| audit_id | emp_id | action_type | old_salary | new_salary |
+----------+--------+-------------+------------+------------+
|        1 |    101 | INSERT      |       NULL |    5000.00 |
|        2 |    101 | UPDATE      |    5000.00 |   60000.00 |
+----------+--------+-------------+------------+------------+

mysql> DELIMITER //
mysql> CREATE TRIGGER after_employee_delete
    -> AFTER DELETE ON Employee
    -> FOR EACH ROW
    -> BEGIN
    -> INSERT INTO Employee_Audit
    -> (emp_id, action_type, old_salary)
    -> VALUES
    -> (OLD.emp_id, 'DELETE', OLD.salary);
    -> END //
