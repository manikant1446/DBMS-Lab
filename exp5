mysql> SELECT Student.Stud_ID,
    -> Student.Stud_Name,
    -> Department.Dept_Name
    -> FROM Student, Department
    -> WHERE Student.Dept_ID = Department.Dept_ID;
+---------+-----------+-----------+
| Stud_ID | Stud_Name | Dept_Name |
+---------+-----------+-----------+
|       1 | Manikant  | CSE       |
|       2 | Khushal   | IT        |
|       3 | Manan     | ME        |
+---------+-----------+-----------+


mysql> SELECT Department.Dept_Name,
    -> COUNT(Student.Stud_ID) AS Total_Students
    -> FROM Student, Department
    -> WHERE Student.Dept_ID = Department.Dept_ID
    -> GROUP BY Department.Dept_Name;
+-----------+----------------+
| Dept_Name | Total_Students |
+-----------+----------------+
| CSE       |              1 |
| IT        |              1 |
| ME        |              1 |
+-----------+----------------+



mysql> SELECT Department.Dept_Name,
