SELECT
    p.student_id,
    p.first_name,
    p.last_name,
    p.email,
    a.course_name,
    a.semester,
    a.gpa
FROM student_profiles AS p
JOIN student_academics AS a
ON p.student_id = a.student_id;

-- Count student profiles
SELECT COUNT(*) AS total_students
FROM student_profiles;

-- Display student profiles
SELECT * FROM student_profiles;

-- Display academic records
SELECT * FROM student_academics;


