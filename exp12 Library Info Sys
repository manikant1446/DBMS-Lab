INSERT INTO issues (book_id, member)
VALUES (1, 'Amit');

-- Update available copies after issuing
UPDATE books
SET available = available - 1
WHERE id = 1 AND available > 0;

-- Return a book
UPDATE issues
SET returned = CURRENT_DATE
WHERE id = 1 AND returned IS NULL;

-- Update available copies after returning
UPDATE books
SET available = available + 1
WHERE id = 1;

-- Display all books
SELECT * FROM books;

-- Search books by title or author
SELECT *
FROM books
WHERE title LIKE '%Code%'
   OR author LIKE '%Code%';

-- Display books that have not been returned
SELECT b.title, i.member, i.issued
FROM issues AS i
JOIN books AS b
ON b.id = i.book_id
WHERE i.returned IS NULL;